---
# Copy to local.yml. This file is ignored by Git.
preflight_network_timeout: 15
preflight_storage_path: /srv
preflight_minimum_free_bytes: 400000000000

hardening_upgrade_packages: true
hardening_automatic_security_updates: false
hardening_disable_ssh: true

# Open only the host service ports needed for the current event.
# These allow IPv4 and IPv6 connections from any source.
hardening_allowed_tcp_ports: []
hardening_allowed_udp_ports: []

# Optional Docker socket access. Members of this group can take full control of
# the host; leave empty to use `sudo docker ...` instead.
docker_group_users: []
# docker_group_users: [your_username]

# Package lists for the standard tooling playbooks can be replaced here. See the
# role defaults for their complete values.
# tooling_core_packages: []
# tooling_network_packages: []
# tooling_pivoting_packages: []
# tooling_analysis_packages: []
# tooling_media_packages: []
# tooling_windows_packages: []
# tooling_bloodhound_packages: []
# tooling_desktop_packages: []
# tooling_exploitation_packages: []
# tooling_reversing_packages: []
# tooling_mobile_packages: []
# tooling_web_packages: []
# tooling_wordlists_packages: []
# tooling_c2_packages: []

# Tuoni source is always installed. Set this to false to defer downloading its
# container images until the first explicit use.
tooling_c2_tuoni_stage_images: true
tooling_c2_tuoni_pull_timeout: 3600

# Burp Suite Community is started with this Java heap limit.
tooling_web_burp_max_heap: 4g

# Optional BloodHound CE staging can download several large container images.
tooling_bloodhound_enabled: false
tooling_bloodhound_install_timeout: 3600

# Optional Android Studio profile. This downloads the IDE, SDK, emulator, the
# newest stable Google APIs x86_64 image, and a separate Android 14 Google Play
# image patched with Magisk by rootAVD. It creates stopped AVDs named "deburner"
# and "deburner-rooted" for the desktop user. Enabling it can consume tens of
# gigabytes and briefly boots the rooted AVD headlessly while provisioning it.
# Setting the license flag confirms that you have reviewed and accepted the
# Android SDK license shown at https://developer.android.com/studio/terms.
tooling_mobile_android_studio_enabled: false
tooling_mobile_android_licenses_accepted: false

# User and desktop customization. An empty value selects the account with UID
# 1000. Set the account name explicitly if the desktop user has another UID.
customization_user: ''

# Optional local Debian package mirror. The initial sync can run for hours and
# requires the machine to remain powered on with Internet access.
offline_mirror_enabled: false
offline_mirror_root: /srv/deburner/mirror
offline_mirror_minimum_free_bytes: 400000000000
offline_mirror_sync_timeout: 43200
offline_mirror_include_sources: false
offline_mirror_include_contents: false
